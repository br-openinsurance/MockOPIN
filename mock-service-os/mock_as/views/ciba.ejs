<div>
  <h1 class="text-[24px] font-semibold text-gray-800 mt-10 mb-4 text-left">
    Decoupled authorization (CIBA)
  </h1>

  <% if (locals.message) { %>
    <p class="text-green-700 text-sm mb-4"><%= message %></p>
  <% } %>
  <% if (locals.error) { %>
    <p class="text-red-600 text-sm mb-4"><%= error %></p>
  <% } %>

  <p class="text-gray-600 text-sm mb-4">
    The requests below are waiting for a user to approve them out-of-band.
    Select one to sign in and authorize the consent.
  </p>

  <% if (!pending || pending.length === 0) { %>
    <p class="text-gray-500 text-sm">No authorization requests pending.</p>
  <% } else { %>
    <ul class="divide-y divide-gray-200">
      <% pending.forEach((entry) => { %>
        <li class="py-3">
          <a
            href="/ciba/authorize/<%= entry.id %>"
            class="text-[#168095] hover:underline"
          >
            Authorize consent <%= entry.consentId %>
          </a>
          <div class="text-gray-500 text-xs">client: <%= entry.clientId %></div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<div class="mt-6 text-gray-400 text-sm text-center">Powered by Raidiam</div>
