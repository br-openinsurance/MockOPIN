<configuration>
<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="com.raidiam.trustframework.mockinsurance.logging.JsonLoggingEncoder"/>
</appender>

<logger name="org.hibernate" level="INFO"/>
<logger name="com.raidiam.trustframework.mockinsurance" level="${LOG_LEVEL:-INFO}"/>

<logger name="io.micronaut.security" level="${LOG_LEVEL:-INFO}"/>
<logger name="io.micronaut" additivity="false" level="${LOG_LEVEL:-INFO}">
    <appender-ref ref="STDOUT"/>
</logger>

<root level="${LOG_LEVEL:-INFO}">
    <appender-ref ref="STDOUT"/>
</root>
</configuration>
